{
  "name": "lacrossetube",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.cjs tests/*.test.mjs && node tests/field.mjs && python3 -m unittest discover -s tests -p 'test_*.py' && npm --prefix mcp/owner test",
