    "functions:serve": "supabase functions serve --env-file supabase/.env.local"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@supabase/supabase-js": "2.118.0"
  },
  "devDependencies": {
    "supabase": "2.121.0",
    "vite": "8.3.4"
  }
}
